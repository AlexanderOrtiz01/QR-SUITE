# Configuración de Firebase (Fase 1 del roadmap).
# Copia este archivo a .env.local y rellena los valores del proyecto Firebase:
# Consola de Firebase > Configuración del proyecto > Tus apps > Config.
# Mientras estén vacíos, la aplicación usa el almacenamiento local del
# navegador y el acceso simulado, que no protege nada.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Dominio corto del motor de redirección (ej. qr.clases.edu.sv).
# Si se deja vacío se usa el origen actual de la aplicación.
VITE_SHORT_DOMAIN=

# Dominio institucional permitido para el login restringido (Módulo 1).
# Es la comprobación que decide quién entra: no se edita desde la interfaz.
VITE_ALLOWED_EMAIL_DOMAIN=clases.edu.sv
