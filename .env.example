# Configuración de Firebase (Fase 1 del roadmap).
# Copia este archivo a .env.local y rellena los valores del proyecto Firebase.
# Mientras estén vacíos, la aplicación usa el almacenamiento local del navegador.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Dominio corto del motor de redirección (ej. qr.clases.edu).
# Si se deja vacío se usa el origen actual de la aplicación.
VITE_SHORT_DOMAIN=

# Dominio institucional permitido para el login restringido (Módulo 1).
VITE_ALLOWED_EMAIL_DOMAIN=clases.edu
